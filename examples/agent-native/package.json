{
  "name": "@hazem3500/replays-example-agent-native",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsrs --fast false --noEmit",
    "start": "node --experimental-strip-types --no-warnings src/server.ts",
    "check": "pnpm build && pnpm typecheck",
    "test:browser": "playwright test -c playwright.config.ts"
  },
  "dependencies": {
    "@agent-native/core": "0.220.0",
    "@hazem3500/replays": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "@types/node": "22.18.10",
    "@playwright/test": "1.64.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vitest": "5.0.5",
    "tsrs": "0.20.0-ts7.1.0-beta"
  }
}
