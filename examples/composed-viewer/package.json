  },
  "dependencies": {
    "@hazem3500/replays": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.18.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "tsrs": "0.20.0-ts7.1.0-beta"
  }
}
