{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"],
    "noEmit": true,
    "paths": {
      "@/*": ["./src/client/*"],
      "@hazem3500/replays": ["./src/index.ts"],
      "@hazem3500/replays/capture": ["./src/capture/index.ts"],
      "@hazem3500/replays/server": ["./src/server/index.ts"],
      "@hazem3500/replays/plugin": ["./src/plugin/index.ts"],
      "@hazem3500/replays/config": ["./src/config/index.ts"],
      "@hazem3500/replays/viewer": ["./src/client/plugins/api.ts"]
    }
  },
  "include": [
    "src",
    "test",
    "e2e",
    "scripts/*.d.mts",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "examples/custom-distro/e2e",
    "examples/custom-distro/playwright.config.ts",
    "examples/custom-distro/src",
    "examples/custom-distro/replays.config.ts"
  ]
}
