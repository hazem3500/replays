{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["headroomPercent", "files"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "headroomPercent": {
      "const": 3
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["raw", "gzip", "brotli"],
        "additionalProperties": false,
        "properties": {
          "raw": {
            "type": "integer",
            "minimum": 0
          },
          "gzip": {
            "type": "integer",
            "minimum": 0
          },
          "brotli": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "allowances": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "cap", "reason", "pr"],
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "cap": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
              "raw": {
                "type": "integer",
                "minimum": 0
              },
              "gzip": {
                "type": "integer",
                "minimum": 0
              },
              "brotli": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "reason": {
            "type": "string",
            "minLength": 20
          },
          "pr": {
            "type": "string",
            "pattern": "^https://github\\.com/hazem3500/replays/pull/[1-9]\\d*$"
          }
        }
      }
    }
  }
}
