      "default": "./dist/lib/plugin.mjs"
    },
    "./config": {
      "types": "./dist/types/config/index.d.ts",
      "default": "./dist/lib/config.mjs"
    },
    "./plugins/iap": {
      "types": "./dist/types/first-party/iap.d.ts",
      "default": "./dist/lib/plugins-iap.mjs"
    },
    "./plugins/gcs": {
      "types": "./dist/types/first-party/gcs.d.ts",
      "default": "./dist/lib/plugins-gcs.mjs"
    },
    "./package.json": "./package.json",
    "./recorder/early": "./dist/lib/recorder-early.js",
    "./recorder/kit": {
      "types": "./dist/types/recorder/kit/index.d.ts",
      "default": "./dist/lib/recorder-kit.mjs"
    },
    "./recorder/ui": {
      "types": "./dist/types/recorder/ui/index.d.ts",
      "default": "./dist/lib/recorder-ui.mjs"
    },
    "./recorder/react": {
      "types": "./dist/types/recorder/react/index.d.ts",
      "default": "./dist/lib/recorder-react.mjs"
    },
    "./recorder/testing": {
      "types": "./dist/types/recorder/testing/index.d.ts",
      "default": "./dist/lib/recorder-testing.mjs"
    },
    "./recorder": {
      "types": "./dist/types/recorder/index.d.ts",
      "browser": "./dist/lib/recorder.mjs",
      "default": "./dist/lib/recorder.mjs"
    },
    "./model": {
      "types": "./dist/types/shared/model.d.ts",
      "default": "./dist/lib/model.mjs"
    },
    "./viewer/playback": {
      "types": "./dist/types/client/playback/index.d.ts",
      "default": "./dist/lib/viewer-playback.mjs"
    },
    "./viewer/diagnostics": {
      "types": "./dist/types/client/diagnostics.d.ts",
      "default": "./dist/lib/viewer-diagnostics.mjs"
    },
    "./viewer/react": {
      "types": "./dist/types/client/compose/index.d.ts",
      "default": "./dist/lib/viewer-react.mjs"
    },
    "./viewer/playback/style.css": {
      "types": "./dist/types/client/styles/render.d.ts",
      "default": "./dist/lib/viewer-playback.css"
    },
    "./viewer/react/style.css": {
      "types": "./dist/types/client/styles/render.d.ts",
      "default": "./dist/lib/viewer-react.css"
    }
  },
