{
  "name": "@hazem3500/replays",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --experimental-strip-types --no-warnings src/server/main.ts --dev",
    "build": "vite build",
    "build:site": "node scripts/build-site.mjs",
    "build:cli": "node scripts/build-cli.mjs && node scripts/build-lib.mjs && tsc -p tsconfig.lib.json && node scripts/fix-types.mjs",
    "start": "node --experimental-strip-types --no-warnings src/server/main.ts",
    "cli": "node --experimental-strip-types --no-warnings src/cli.ts",
    "capture": "node --experimental-strip-types --no-warnings src/cli.ts capture",
    "lint": "oxlint --deny-warnings",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vite build --logLevel warn && playwright test",
    "shots": "vite build --logLevel warn && node scripts/shots.mjs",
    "shots:comments": "vite build --logLevel warn && node scripts/shots-comments.mjs",
    "sample": "node scripts/record-sample.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "test:distro": "pnpm build && pnpm build:cli && pnpm --filter @hazem3500/replays-example-custom-distro build && pnpm --filter @hazem3500/replays-example-custom-distro typecheck && playwright test -c examples/custom-distro/playwright.config.ts",
    "test:pack": "node scripts/pack-smoke.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@number-flow/react": "0.6.2",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.12.0",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@tanstack/react-query": "5.104.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "esbuild": "0.28.2",
    "lucide-react": "1.55.0",
    "playwright-core": "1.64.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rrweb": "2.1.7",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.18.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "oxlint": "1.87.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "description": "Record browser sessions (rrweb + steps + console + network + performance) into one portable replay, and play them back in a self-hostable viewer.",
  "license": "MIT",
  "author": "Hazem (hazem3500)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hazem3500/replays.git"
  },
  "bin": {
    "replays": "./bin/replays.mjs"
  },
  "files": [
    "bin",
    "dist/cli",
    "dist/lib",
    "dist/types",
    "dist/client",
    "sample",
    "docs/api-stability.md",
    "docs/extension-api.md",
    "docs/extending.md",
    "docs/packaging.md",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/lib/index.mjs"
    },
    "./capture": {
      "types": "./dist/types/capture/index.d.ts",
      "default": "./dist/lib/capture.mjs"
    },
    "./server": {
      "types": "./dist/types/server/index.d.ts",
      "default": "./dist/lib/server.mjs"
    },
    "./viewer": {
      "types": "./dist/types/client/plugins/api.d.ts",
      "default": "./dist/lib/viewer.mjs"
    },
    "./plugin": {
      "types": "./dist/types/plugin/index.d.ts",
      "default": "./dist/lib/plugin.mjs"
    },
    "./config": {
      "types": "./dist/types/config/index.d.ts",
      "default": "./dist/lib/config.mjs"
    },
    "./package.json": "./package.json"
  }
}
