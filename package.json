{
  "name": "@hazem3500/replays",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": "^22.22.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "node --experimental-strip-types --no-warnings src/server/main.ts --dev",
    "build": "vp run cached:build && vp run cached:start",
    "build:site": "node scripts/build-site.mjs",
    "build:cli": "vp run cached:package",
    "build:capture": "node scripts/build-capture.mjs",
    "start": "node --experimental-strip-types --no-warnings src/server/main.ts",
    "cli": "node --experimental-strip-types --no-warnings src/cli.ts",
    "capture": "node --experimental-strip-types --no-warnings src/cli.ts capture",
    "lint": "vp lint --config .oxlintrc.json --deny-warnings && pnpm lint:types",
    "format": "vp fmt --config .oxfmtrc.json --write .",
    "format:check": "vp fmt --config .oxfmtrc.json --check .",
    "typecheck": "tsrs --fast false --noEmit",
    "test": "vp test run --config vitest.config.ts",
    "test:postgres": "vp test run --config vitest.config.ts test/agent-native-runtime.test.ts test/agent-native-postgres.test.ts --maxWorkers=1",
    "test:e2e": "vp run cached:build --logLevel warn && vp run cached:start --logLevel warn && playwright test",
    "shots": "vp build --logLevel warn && node scripts/shots.mjs",
    "shots:comments": "vp build --logLevel warn && node scripts/shots-comments.mjs",
    "shots:malleable": "vp build --logLevel warn && node --experimental-strip-types --no-warnings scripts/shots-malleable.mjs",
    "sample": "node scripts/record-sample.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "test:distro": "pnpm build && pnpm build:cli && pnpm --filter @hazem3500/replays-example-custom-distro build && pnpm --filter @hazem3500/replays-example-custom-distro typecheck && playwright test -c examples/custom-distro/playwright.config.ts",
    "test:pack": "node scripts/pack-smoke.mjs",
    "test:host-app": "pnpm build && pnpm build:cli && pnpm --filter @hazem3500/replays-example-host-app check",
    "storybook": "storybook dev -p 6006 --no-open --disable-telemetry",
    "build:storybook": "storybook build --disable-telemetry",
    "typecheck:storybook": "tsrs --fast false -p .storybook/tsconfig.json --noEmit",
    "lint:types": "vp lint --type-aware --config .oxlintrc.types.json --deny-warnings src/shared",
    "lint:types:audit": "vp lint --type-aware --config .oxlintrc.types.json --deny-warnings",
    "build:recorder": "node scripts/build-recorder.mjs && tsrs --fast false -p tsconfig.recorder.json && node scripts/fix-types.mjs",
    "test:recorder": "vp test run --config vitest.recorder.config.ts",
    "quality:knip": "node scripts/quality-report.mjs knip --reporter json",
    "quality:boundaries": "node scripts/quality-report.mjs depcruise --config .dependency-cruiser.cjs --output-type json src",
    "quality:package": "node scripts/quality-package.mjs",
    "quality:size": "node scripts/quality-size.mjs",
    "quality:dedupe": "node scripts/quality-report.mjs pnpm dedupe --check --ignore-scripts",
    "quality:hooks": "lefthook validate",
    "hooks:install": "lefthook install",
    "quality": "pnpm quality:knip && pnpm quality:boundaries && pnpm quality:package && pnpm quality:size && pnpm quality:dedupe && pnpm quality:hooks && pnpm quality:test",
    "quality:size:ratchet": "node scripts/quality-size.mjs --ratchet",
    "quality:size:base": "bash scripts/ci-size-base.sh",
    "quality:size:ci": "node scripts/quality-size.mjs --baseline .review-artifacts/quality/main-bundle-sizes.json --baseline-budgets .review-artifacts/quality/main-budgets.json --check-ratchet",
    "quality:test": "node --test scripts/build-cli.test.mjs scripts/build-lib.test.mjs scripts/quality-tooling.test.mjs scripts/bundle-budgets.test.mjs scripts/mutation-report.test.mjs scripts/quality-report.test.mjs",
    "check:quick": "vp run cached:lint && vp run cached:format && vp run cached:types && pnpm test:changed",
    "test:changed": "vp test run --config vitest.config.ts --changed=origin/main --passWithNoTests",
    "test:affected": "vp test run --config vitest.config.ts --changed=${TEST_CHANGED_SINCE:?set TEST_CHANGED_SINCE to the base commit} --passWithNoTests",
    "test:watch": "vp test --config vitest.config.ts",
    "typecheck:watch": "tsrs --fast false --noEmit --watch",
    "lint:ratchet": "node scripts/lint-ratchet.mjs",
    "lint:new-files": "node scripts/lint-new-files.mjs",
    "lint:ratchet:test": "node --test scripts/lint-ratchet.test.mjs",
    "quality:compiler": "node scripts/compiler-report.mjs",
    "mutation": "node scripts/run-mutations.mjs",
    "mutation:report": "node scripts/mutation-report.mjs",
    "mutation:report:test": "node --test scripts/mutation-report.test.mjs"
  },
  "dependencies": {
    "playwright-core": "1.64.0"
  },
  "devDependencies": {
    "@agent-native/core": "0.220.0",
    "@arethetypeswrong/cli": "0.18.5",
    "@axe-core/playwright": "4.13.0",
    "@babel/core": "7.29.7",
