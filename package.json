    "knip": "6.43.0",
    "lefthook": "2.2.2",
    "lucide-react": "1.55.0",
    "motion": "14.9.0",
    "msw": "3.0.3",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "publint": "0.3.25",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rou3": "1.0.0",
    "rrweb": "2.1.7",
    "size-limit": "14.3.0",
    "sonner": "2.0.8",
    "srvx": "1.0.7",
    "storybook": "10.6.3",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tsrs": "0.20.0-ts7.1.0-beta",
    "turbo": "2.11.10",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5",
    "ws": "8.22.0",
    "xstate": "5.33.3",
    "zod": "4.6.7"
  },
  "description": "Record browser sessions (rrweb + steps + console + network + performance) into one portable replay, and play them back in a self-hostable viewer.",
  "license": "MIT",
  "author": "Hazem (hazem3500)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hazem3500/replays.git"
  },
  "bin": {
    "replays": "./bin/replays.mjs"
  },
  "files": [
    "bin",
    "dist/cli",
    "dist/lib",
    "dist/types",
    "dist/client",
    "dist/start",
    "sample",
    "docs/api-stability.md",
    "docs/extension-api.md",
    "docs/extending.md",
    "docs/packaging.md",
    "docs/playback-and-model.md",
    "README.md",
    "LICENSE",
    "docs/recorder.md",
    "!dist/client/.vite",
    "!dist/lib/.metafile.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/lib/index.mjs"
