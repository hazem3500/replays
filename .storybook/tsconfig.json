{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "types": ["node", "vitest/globals", "vite/client"],
    "paths": {
      "@/*": [".././src/client/*"],
      "@hazem3500/replays": [".././src/index.ts"],
      "@hazem3500/replays/capture": [".././src/capture/index.ts"],
      "@hazem3500/replays/server": [".././src/server/index.ts"],
      "@hazem3500/replays/server/testing": [".././src/server/testing/index.ts"],
      "@hazem3500/replays/plugin": [".././src/plugin/index.ts"],
      "@hazem3500/replays/config": [".././src/config/index.ts"],
      "@hazem3500/replays/viewer": [".././src/client/plugins/api.ts"],
      "@hazem3500/replays/plugins/iap": [".././src/first-party/iap.ts"],
      "@hazem3500/replays/plugins/gcs": [".././src/first-party/gcs.ts"],
      "@hazem3500/replays/recorder": [".././src/recorder/index.ts"],
      "@hazem3500/replays/recorder/kit": ["../src/recorder/kit/index.ts"],
      "@hazem3500/replays/recorder/react": ["../src/recorder/react/index.tsx"],
      "@hazem3500/replays/recorder/ui": ["../src/recorder/ui/index.ts"],
      "@hazem3500/replays/recorder/testing": ["../src/recorder/testing/index.ts"]
    }
  },
  "include": ["./*.ts", "./*.tsx", "../stories"]
}
