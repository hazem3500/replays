{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hazem3500/replays/docs/formats/replay.schema.json",
  "title": "Replay bundle",
  "description": "One recorded session: an rrweb recording plus steps, console, network and performance tracks. This is `replay.json`, the body of `POST /api/replays` and `GET /api/replays/<id>`. Times (`at`) are milliseconds from the first rrweb event. The server validates more strictly (sizes, privacy pass); this schema documents the shape tools and plugins can rely on. Source of truth: src/shared/replay.ts.",
  "type": "object",
  "required": ["meta", "events", "console", "network", "steps"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["id", "title", "url", "capturedAt", "duration", "viewport", "eventCount", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$" },
        "title": { "type": "string" },
        "url": { "type": "string" },
        "capturedAt": { "type": "string", "format": "date-time" },
        "duration": { "type": "number", "minimum": 0 },
        "viewport": {
          "type": "object",
          "required": ["width", "height"],
          "properties": { "width": { "type": "number" }, "height": { "type": "number" } }
        },
        "eventCount": { "type": "integer", "minimum": 0 },
        "version": { "const": 1 },
        "videoFile": { "type": "string" },
        "source": { "enum": ["agent", "human"] },
        "profile": {
          "description": "Why it was recorded: one of the deployment's profiles (GET /api/config lists them), checked on upload. Source of truth: src/shared/profiles.ts.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,39}$"
        },
        "purpose": {
          "description": "Deprecated name of `profile`, still read. When both are set they must be equal; the server stores `profile`.",
          "deprecated": true,
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,39}$"
        },
        "tags": {
          "type": "array",
          "maxItems": 10,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,39}$" }
        },
        "captured": {
          "description": "What the capture recorded, so a view can say \"Not captured\" instead of showing an empty table. Absent on older bundles: assume everything but bodies. Source of truth: src/shared/network-bodies.ts.",
          "type": "object",
          "required": ["console", "network", "performance", "video"],
          "additionalProperties": false,
          "properties": {
            "console": { "type": "boolean" },
            "network": { "enum": ["off", "headers", "bodies"] },
            "performance": { "type": "boolean" },
            "video": { "type": "boolean" },
            "inputs": {
              "description": "`visible` when the recorder kept ordinary input values (`privacy.sanitize: false`); absent means masked. Password and hidden inputs are always masked. A claim the server honours only for a host with `privacy.keepVisibleInputs` and a signed-in staff upload on `POST /api/replays`; otherwise it masks every input and drops the claim. Source of truth: src/shared/network-bodies.ts.",
              "enum": ["masked", "visible"]
            }
          }
        },
        "people": {
          "description": "People related to the recording (who asked for it, wrote the change, reviews it), sent explicitly by the producer. Each needs an email or a handle. The server also caps the whole list at 4096 bytes of JSON, and a deployment may restrict roles and handles (`api.people`). Source of truth: src/shared/people.ts.",
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": ["role"],
            "additionalProperties": false,
            "anyOf": [{ "required": ["email"] }, { "required": ["handles"] }],
            "properties": {
              "role": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$" },
              "email": { "type": "string", "maxLength": 254 },
              "name": { "type": "string", "minLength": 1, "maxLength": 80 },
              "handles": {
                "description": "Accounts elsewhere by handle id, e.g. { \"github\": \"octocat\" }.",
                "type": "object",
                "minProperties": 1,
                "maxProperties": 5,
                "propertyNames": { "pattern": "^[a-z][a-z0-9-]{0,39}$" },
                "additionalProperties": { "type": "string", "pattern": "^\\S{1,100}$" }
              }
            }
          }
        }
      }
    },
    "events": {
      "description": "rrweb events (https://github.com/rrweb-io/rrweb). Opaque to this format: at least two, each with a numeric `timestamp`.",
      "type": "array",
      "minItems": 2,
      "items": { "type": "object", "required": ["timestamp"], "properties": { "timestamp": { "type": "number" } } }
    },
    "console": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["at", "level", "message"],
        "properties": {
          "at": { "type": "number" },
          "level": { "enum": ["debug", "info", "log", "warn", "error"] },
          "message": { "type": "string" },
          "url": { "type": "string" }
        }
      }
    },
    "network": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "at", "duration", "method", "url", "status", "statusText", "requestHeaders", "responseHeaders"],
        "properties": {
          "id": { "type": "string" },
          "at": { "type": "number" },
          "duration": { "type": "number" },
          "method": { "type": "string" },
          "url": { "type": "string" },
          "status": { "type": "integer", "description": "HTTP status; 0 when there was no response." },
          "statusText": { "type": "string" },
          "mimeType": { "type": "string" },
          "requestHeaders": { "$ref": "#/$defs/headers" },
          "responseHeaders": { "$ref": "#/$defs/headers" },
          "requestBody": { "$ref": "#/$defs/body" },
          "responseBody": { "$ref": "#/$defs/body" }
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["at", "kind", "label"],
        "properties": {
          "at": { "type": "number" },
          "kind": { "type": "string" },
          "label": { "type": "string" },
          "selector": { "type": "string" },
          "url": { "type": "string" }
        }
      }
    },
    "performance": {
      "type": "object",
      "required": ["supported", "entries"],
      "properties": {
        "supported": { "type": "array", "items": { "enum": ["paint", "largest-contentful-paint", "longtask", "event"] } },
        "entries": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "required": ["at", "kind", "value"],
            "properties": {
              "at": { "type": "number" },
              "kind": { "enum": ["first-contentful-paint", "largest-contentful-paint", "long-task", "slow-interaction"] },
              "value": { "type": "number" },
              "eventType": { "type": "string" }
            }
          }
        }
      }
    },
    "context": { "$ref": "context.schema.json" },
    "suiteRun": {
      "type": "object",
      "required": ["suiteId", "runId"],
      "additionalProperties": false,
      "properties": {
        "suiteId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$" },
        "runId": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-]{0,79}$" }
      }
    }
  },
  "$defs": {
    "body": {
      "description": "A request or response body, kept only when the capture asked for bodies. The text is redacted (secret fields, credentials, JWTs, card numbers, email addresses, the deployment's rules) and at most 65536 bytes before redaction. Source of truth: src/shared/network-bodies.ts.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string" },
        "size": { "type": "integer", "minimum": 0, "description": "Bytes of the original body, when known." },
        "truncated": { "const": true, "description": "The text stops at the capture's limit." },
        "omitted": {
          "enum": ["content-type", "unavailable"],
          "description": "Why there is no text: a content type outside the allowlist (binary included), or nothing the browser exposed."
        }
      }
    },
    "headers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "value"],
        "properties": { "name": { "type": "string" }, "value": { "type": "string" } }
      }
    }
  }
}
