{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hazem3500/replays/docs/formats/edits.schema.json",
  "title": "Replay edits",
  "description": "`<replay id>/edits.json` (beta editor): a non-destructive edit list. The recording is never changed; viewers apply this list, and video exports render the timing and visual effects but exclude navigation highlights. Every time is on the ORIGINAL timeline (ms from the first rrweb event). `revision`, `updatedBy` and `updatedAt` are written by the server. Source of truth: src/shared/edits.ts and src/shared/effects.ts.",
  "type": "object",
  "required": ["version", "cuts"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "trim": {
      "type": "object",
      "required": ["start", "end"],
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "cuts": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/range",
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 120
          }
        }
      }
    },
    "zooms": {
      "type": "array",
      "description": "The editor keeps zooms from overlapping; scale is any value in range, not only the quick marks 1.4, 1.8 and 2.2.",
      "maxItems": 100,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/range"
          }
        ],
        "properties": {
          "scale": {
            "type": "number",
            "minimum": 1.1,
            "maximum": 3
          },
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": ["scale"]
      }
    },
    "speeds": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/range"
          }
        ],
        "properties": {
          "rate": {
            "description": "Playback rate of the stretch. 1.5 was added later; older edit lists hold only 2, 4 or 8.",
            "enum": [1.5, 2, 4, 8]
          }
        },
        "required": ["rate"]
      }
    },
    "blurs": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/range"
          }
        ],
        "required": ["x", "y", "width", "height"],
        "properties": {
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "width": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "height": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "style": {
            "enum": ["blur", "redact"],
            "default": "blur"
          }
        }
      }
    },
    "captions": {
      "type": "array",
      "maxItems": 100,
      "description": "Captions take turns: no two cover the same moment. Saving a list where they overlap ends the earlier caption where the later one starts.",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/range"
          }
        ],
        "required": ["text"],
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 160
          }
        }
      }
    },
    "highlights": {
      "type": "array",
      "maxItems": 200,
      "description": "Playback navigation annotations on the original timeline. They are mapped for the viewer and are not burned into video exports.",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["id", "kind", "at"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
              },
              "kind": {
                "const": "point"
              },
              "at": {
                "type": "number",
                "minimum": 0
              },
              "label": {
                "type": "string",
                "maxLength": 120
              }
            }
          },
          {
            "type": "object",
            "required": ["id", "kind", "from", "to"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
              },
              "kind": {
                "const": "period"
              },
              "from": {
                "type": "number",
                "minimum": 0
              },
              "to": {
                "type": "number",
                "minimum": 0,
                "description": "At least 100 ms after `from`."
              },
              "label": {
                "type": "string",
                "maxLength": 120
              }
            }
          }
        ]
      }
    },
    "cursor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "visible": {
          "type": "boolean",
          "default": true
        },
        "size": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2,
          "default": 1
        },
        "hideWhenIdle": {
          "type": "boolean",
          "default": true
        },
        "clickFeedback": {
          "type": "boolean",
          "default": true
        },
        "motion": {
          "enum": ["signature_arc", "spring_settle", "magnetic", "comet_swoop", "adaptive", "classic"],
          "default": "signature_arc"
        },
        "appearance": {
          "enum": ["arrow", "classic-arrow", "hand", "dot", "ring", "agent"],
          "default": "arrow"
        },
        "color": {
          "enum": ["accent", "periwinkle", "green", "amber", "coral", "graphite"]
        },
        "clickEffect": {
          "enum": ["press", "ripple", "pulse"],
          "description": "The style's own click effect when omitted."
        }
      }
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "updatedBy": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "range": {
      "type": "object",
      "required": ["id", "from", "to"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
        },
        "from": {
          "type": "number",
          "minimum": 0
        },
        "to": {
          "type": "number",
          "minimum": 0,
          "description": "Greater than `from`."
        }
      }
    }
  }
}
