{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hazem3500/replays/docs/formats/suite-plan.schema.json",
  "title": "Suite plan",
  "description": "The file `replays suite record --plan <file>` reads: a review suite's metadata and the runs to record. Each run is captured with the closed step vocabulary of `replays capture --steps`, uploaded to its suite run and marked passed or failed. Source of truth: src/suite/plan.ts.",
  "type": "object",
  "required": ["id", "title", "runs"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,79}$",
      "description": "The suite's id; the link is <server>/s/<id>. Registering it again is fine."
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "profile": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "One of the server's profiles, such as design-review; the suite opens in that profile's view."
    },
    "source": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*:.+$",
      "description": "What the suite is about, as <provider>:<reference>, e.g. github:owner/repo#12."
    },
    "people": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "description": "role:email[:handle=value], e.g. reviewer:ada@example.com" },
      "description": "People on the suite and on every replay it records."
    },
    "summary": { "$ref": "#/$defs/summary", "description": "What the suite found and did not cover." },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Pin it for a plan that is run again; otherwise the first run's clock is used and later runs reuse what the server stored."
    },
    "runs": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/run" } }
  },
  "$defs": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "description": "Plain text: paragraphs split by blank lines and `- ` bullet lines."
    },
    "run": {
      "type": "object",
      "required": ["id", "title", "url", "steps"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-]{0,79}$",
          "description": "Unique in the plan. A finished run keeps its status, so a re-run needs a new id."
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "url": { "type": "string", "format": "uri", "description": "https, or http on localhost." },
        "steps": { "type": "array", "items": { "$ref": "#/$defs/step" }, "description": "Use [] to just open the page." },
        "viewport": {
          "oneOf": [
            { "type": "string", "pattern": "^\\d{3,5}x\\d{3,5}$" },
            {
              "type": "object",
              "required": ["width", "height"],
              "additionalProperties": false,
              "properties": { "width": { "type": "integer", "minimum": 100 }, "height": { "type": "integer", "minimum": 100 } }
            }
          ],
          "description": "Default 1440x900."
        },
        "expect": {
          "type": "object",
          "additionalProperties": false,
          "description": "Checks on what was recorded; the run is marked failed when one does not hold.",
          "properties": {
            "noConsoleErrors": { "type": "boolean" },
            "noFailedRequests": { "type": "boolean", "description": "No request answered 400 or above." },
            "maxDurationMs": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "summary": { "$ref": "#/$defs/summary", "description": "What this run checked; kept on the run, with any failure reasons added." }
      }
    },
    "step": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["click", "hover", "type", "fill", "press", "wait", "scroll", "goto", "shot"] },
        "label": { "type": "string", "minLength": 1 },
        "selector": { "type": "string", "minLength": 1 },
        "text": { "type": "string" },
        "key": { "type": "string", "minLength": 1 },
        "ms": { "type": "number", "minimum": 0 },
        "direction": { "enum": ["up", "down", "left", "right"] },
        "pixels": { "type": "number", "minimum": 0 },
        "state": { "enum": ["visible", "attached", "hidden"], "description": "A selector wait: what to wait for (default visible)." },
        "timeout": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 300000,
          "description": "A selector wait: longest wait in ms (default 15000)."
        },
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$", "description": "A shot: the PNG name, unique in the run." },
        "url": { "type": "string" }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "enum": ["click", "hover", "type", "fill"] } } }, "then": { "required": ["selector"] } },
        { "if": { "properties": { "kind": { "enum": ["type", "fill"] } } }, "then": { "required": ["text"] } },
        { "if": { "properties": { "kind": { "const": "press" } } }, "then": { "required": ["key"] } },
        {
          "if": { "properties": { "kind": { "const": "wait" } } },
          "then": { "oneOf": [{ "required": ["ms"] }, { "required": ["selector"] }] }
        },
        {
          "if": { "properties": { "kind": { "const": "scroll" } } },
          "then": { "oneOf": [{ "required": ["direction"] }, { "required": ["selector"] }] }
        },
        { "if": { "properties": { "kind": { "const": "shot" } } }, "then": { "required": ["name"] } },
        { "if": { "properties": { "kind": { "const": "goto" } } }, "then": { "required": ["url"] } }
      ]
    }
  }
}
