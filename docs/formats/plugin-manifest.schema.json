{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hazem3500/replays/docs/formats/plugin-manifest.schema.json",
  "title": "User plugin manifest (beta.malleable)",
  "description": "What a user plugin contributes and which capabilities it asks for. The plugin's code runs in a sandboxed frame and can use only the capabilities listed in `permissions`; `comments:write` and `export:download` additionally ask the person each time the page loads. Source of truth: src/shared/malleable.ts.",
  "type": "object",
  "required": ["format", "id", "name", "contributes"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "replays-user-plugin/1" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 60 },
    "description": { "type": "string", "maxLength": 300 },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "default": [],
      "items": { "enum": ["replay:read", "playback:seek", "comments:read", "notify", "comments:write", "export:download"] }
    },
    "contributes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "tabs": { "$ref": "#/$defs/contributions" },
        "panels": { "$ref": "#/$defs/contributions" },
        "actions": { "$ref": "#/$defs/contributions" }
      }
    }
  },
  "$defs": {
    "contributions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
          "label": { "type": "string", "minLength": 1, "maxLength": 40 }
        }
      }
    }
  }
}
