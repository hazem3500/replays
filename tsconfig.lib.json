{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rewriteRelativeImportExtensions": true,
    "outDir": "dist/types",
    "rootDir": "src",
    "types": ["node"]
  },
  "include": [
    "src/client/env.d.ts",
    "src/server/json-schema.d.ts",
    "src/index.ts",
    "src/capture/index.ts",
    "src/server/index.ts",
    "src/server/testing/index.ts",
    "src/plugin/index.ts",
    "src/config/index.ts",
    "src/client/plugins/api.ts",
    "src/first-party/iap.ts",
    "src/first-party/gcs.ts",
    "src/shared/model.ts",
    "src/client/playback/index.ts",
    "src/client/compose/index.ts",
    "src/client/diagnostics.ts"
  ],
  "exclude": ["src/capture/injected-recorder.ts", "src/server/storage/traced.ts"]
}
