{
  "$schema": "https://unpkg.com/oxfmt@0.74.0/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 140,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "semi": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "singleAttributePerLine": false,
  "quoteProps": "as-needed",
  "objectWrap": "preserve",
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "embeddedLanguageFormatting": "off",
  "sortImports": false,
  "sortPackageJson": false,
  "sortTailwindcss": false,
  "ignorePatterns": [
    "/src/client/routeTree.gen.ts",
    "**/dist/**",
    "**/shots/**",
    "/sample/*.json",
    "/pnpm-lock.yaml",
    "**/playwright-report/**",
    "**/test-results/**",
    "/.claude/**",
    "/.review-artifacts/**",
    "/.ship/**",
    "**/*.css",
    "**/*.scss",
    "**/*.less",
    "**/*.md",
    "**/*.mdx",
    "**/*.markdown",
    "**/*.yaml",
    "**/*.yml",
    "**/*.toml",
    "**/*.html",
    "**/*.htm",
    "**/*.vue",
    "**/*.svelte",
    "**/*.astro",
    "**/*.hbs",
    "**/*.handlebars",
    "**/*.mjml",
    "**/*.json5"
  ]
}
